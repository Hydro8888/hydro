# Database (PostgreSQL - Docker instance)
DATABASE_URL="postgresql://postgres:postgres@172.17.0.1:5432/livenews?schema=public"

# Redis (Docker instance)
REDIS_URL="redis://172.17.0.1:6379"

# OpenAI API — enter the key with:  bash set-ai-key.sh   (never commit a real key)
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-6.1-terra"
# Optional (leave commented to use the defaults):
# OPENAI_REASONING_EFFORT=none            # none (default, cheapest) | low | medium | high | xhigh | max | default
# OPENAI_IMAGE_GENERATION=false           # true = AI image for articles without a photo (costs per image)
# OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
# OPENAI_IMAGE_DIR="/home/ubuntu/livenews/data/generated-images"
# OPENAI_BASE_URL="https://api.openai.com/v1"   # proxy / mock server (http or https)
# OPENAI_TIMEOUT_MS=60000                 # per request, 1000..600000 (image default 120000)

# App
NEXT_PUBLIC_BASE_URL="http://211.198.54.207/livenews"
NEXT_PUBLIC_APP_NAME="LiveNews"
APP_PORT=4000
NODE_ENV=production

# Ads: AdSlot placeholders are hidden until real ad serving is integrated
NEXT_PUBLIC_ADS_ENABLED=false

# Newsletter: signup forms (footer + home banner) are hidden until a real
# subscription backend exists at /api/newsletter. Build-time flag (rebuild to change).
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
