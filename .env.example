# Database (PostgreSQL - Docker instance)
DATABASE_URL="postgresql://postgres:postgres@172.17.0.1:5432/livenews?schema=public"

# Redis (Docker instance)
REDIS_URL="redis://172.17.0.1:6379"

# xAI Grok API
XAI_API_KEY="xai-your-api-key-here"
XAI_MODEL="grok-4-1-fast"
# Optional (leave commented to use the defaults):
# XAI_IMAGE_MODEL="grok-2-image"
# XAI_BASE_URL="https://api.x.ai/v1"   # point at a proxy / mock server (http or https)
# XAI_TIMEOUT_MS=60000                 # per request, 1000..600000 (image default 120000)

# App
NEXT_PUBLIC_BASE_URL="http://211.198.54.207/livenews"
NEXT_PUBLIC_APP_NAME="LiveNews"
APP_PORT=4000
NODE_ENV=production

# Ads: AdSlot placeholders are hidden until real ad serving is integrated
NEXT_PUBLIC_ADS_ENABLED=false

# Newsletter: signup forms (footer + home banner) are hidden until a real
# subscription backend exists at /api/newsletter. Build-time flag (rebuild to change).
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
