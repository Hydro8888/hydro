# Database
POSTGRES_PASSWORD=your_secure_password_here

# JWT
SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# WorkNet OpenAPI
# 워크넷 채용정보 OpenAPI 인증키 — https://www.work.go.kr/opi/opi/opi/empInfo/empInfoSrch/apiUsageGd.do
WORKNET_API_KEY=

# AI API Keys
# GEMINI_API_KEY is REQUIRED for real-time grounded web search (Google Search grounding).
# Without this key, AI search falls back to static insights only (no external results).
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the grounding model (default: gemini-2.5-flash)
# GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# Optional: override the analysis model (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
